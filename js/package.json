{
  "name": "veritas-lib",
  "version": "0.1.0",
  "description": "JavaScript/TypeScript implementation of the Veritas formula (spectral, residual and neighbourhood score).",
  "license": "MIT",
  "author": "Aaron Abbas <aaron@warcr.net>",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "jsdelivr": "./dist/veritas.min.js",
  "unpkg": "./dist/veritas.min.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/warcr-group-official/veritas-lib.git"
  },
  "bugs": {
    "url": "https://github.com/warcr-group-official/veritas-lib/issues"
  },
  "homepage": "https://github.com/warcr-group-official/veritas-lib#readme",
  "keywords": [
    "veritas",
    "manifold-learning",
    "linear-algebra",
    "spectral",
    "anomaly-detection",
    "data-sanitization"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node scripts/build.mjs && tsc --emitDeclarationOnly",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build",
    "test": "node --test tests/*.test.mjs",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0"
  }
}
